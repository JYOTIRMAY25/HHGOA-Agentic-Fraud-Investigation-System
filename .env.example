# ========================================================
# HHGOA TigerGraph & MCP Configuration
# Copy this file to .env and fill in your connection details.
# DO NOT commit .env to version control.
# ========================================================

# --- Official tigergraph-mcp standard variables ---
# For TigerGraph Cloud / Savanna (https://savanna.tgcloud.io):
#   TG_HOST=https://your-subdomain.i.tgcloud.io
#   TG_TGCLOUD=true
#   TG_PORT=443
#
# For Local TigerGraph Community Edition / Docker:
#   TG_HOST=http://127.0.0.1
#   TG_PORT=9000

TG_HOST=https://YOUR-SAVANNA-ENDPOINT.i.tgcloud.io
TG_GRAPHNAME=HHGOA_Fraud_Graph
TG_USERNAME=tigergraph
TG_PASSWORD=YOUR_PASSWORD_HERE
TG_SECRET=YOUR_DATABASE_SECRET_HERE
TG_TGCLOUD=true
TG_PORT=443

# --- Legacy aliases for Phase 2 scripts ---
TIGERGRAPH_HOST=https://YOUR-SAVANNA-ENDPOINT.i.tgcloud.io
TIGERGRAPH_PORT=443
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=YOUR_PASSWORD_HERE
TIGERGRAPH_GRAPH_NAME=HHGOA_Fraud_Graph
TIGERGRAPH_SECRET=YOUR_DATABASE_SECRET_HERE

# --- MCP Tool Restrictions (Security Policy) ---
# Only expose approved investigation tools; block destructive operations
TG_ALLOWED_TOOLS=read-only
TG_BLOCKED_TOOLS=destructive

# --- MCP Server Transport Configuration ---
MCP_TRANSPORT=stdio

# --- Testing & Offline Verification Flag ---
# Set to 'true' to run MCP tool test suite against verified dataset fixtures when DB is offline
TG_MOCK_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash